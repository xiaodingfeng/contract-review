# 后端环境变量示例
# 复制为 backend/.env 后再填写真实值；不要提交真实 .env、密钥、口令或内网地址。

# 服务监听端口
PORT=3000

# OpenAI 标准 Chat Completions 兼容配置；所有聊天模型统一使用这组变量
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-your-llm-api-key
LLM_MODEL=your-chat-model
# LLM 调用容错：单次请求超时(ms)、失败重试次数、退避基数(ms)
LLM_TIMEOUT_MS=90000
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_MS=800

# 多模态视觉模型配置(3.2 印章与签名分析);复用 LLM_BASE_URL/LLM_API_KEY,仅模型名不同
# 未配置时回退到 tesseract.js OCR
VISION_MODEL_NAME=your-version-model
# 印章 OCR 语言包(tesseract.js),多语言用 + 号连接
SEAL_OCR_LANG=chi_sim+eng

# 向量化模型配置；未配置 API Key 时系统会退回到本地 mock embedding，仅适合开发验证
EMBEDDING_BASE_URL=https://api.example.com/v1
EMBEDDING_API_KEY=sk-your-embedding-api-key
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16

# 重排模型配置；未配置 API Key 时跳过重排
RERANK_BASE_URL=https://api.example.com/v1
RERANK_API_KEY=sk-your-rerank-api-key
RERANK_MODEL=your-rerank-model

# PostgreSQL 配置；生产环境优先使用 DATABASE_URL
DATABASE_URL=postgres://contract_review:contract_review@127.0.0.1:5432/contract_review
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=contract_review
POSTGRES_PASSWORD=contract_review
POSTGRES_DB=contract_review
DB_POOL_MIN=0
DB_POOL_MAX=10

# Milvus 向量库配置；VECTOR_STORE=milvus 时使用，缺失地址会自动回退到 PostgreSQL 向量字段
VECTOR_STORE=milvus
MILVUS_ADDRESS=localhost:19530
MILVUS_COLLECTION=contract_review_knowledge
MILVUS_DATABASE=default
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_TOKEN=
MILVUS_SSL=false
MILVUS_CONNECT_TIMEOUT_MS=3000

# OnlyOffice 配置；JWT_SECRET 必须与 Document Server 保持一致
ONLYOFFICE_JWT_SECRET=change-me-onlyoffice-jwt-secret
ONLYOFFICE_URL=http://localhost:8081
APP_HOST=http://localhost:3000
BACKEND_URL_FOR_DOCKER=http://host.docker.internal:3000

# 知识库初始化配置
# 专属知识库模式：启用后，合同审查和智能问答均禁止公网搜索或外部主体核验
REVIEW_KB_ONLY_MODE=false
# LAW_SEED_DIRS 留空则遍历整个 data/laws 目录(递归所有子目录);多个目录用逗号分隔
# CASE_SEED_LIMIT 留空则导入 CASE_SEED_DIR 目录下所有 JSON;设为正整数限制数量;设为 0 不导入
KNOWLEDGE_SEED_TYPES=law,case
LAW_SEED_DIRS=
LAW_SEED_FILE_BATCH_SIZE=20
CASE_SEED_DIR=data/candidate_55192
CASE_SEED_LIMIT=
# 强制重灌知识库数据(每次启动时清空并重新嵌入)；默认 false
FORCE_RESEED_LAWS=false
FORCE_RESEED_CASES=false

# 知识库批量导入限制
KNOWLEDGE_BATCH_FILE_LIMIT=200
KNOWLEDGE_BATCH_ENTRY_SIZE=50
KNOWLEDGE_IMPORT_FILE_SIZE_LIMIT=52428800

# 智能问答历史上下文限制
QA_MAX_HISTORY_MESSAGES=12
QA_MAX_HISTORY_CHARS=4000

# 知识库检索 rerank 阈值：只对 rerank_score 生效；设为 0 关闭阈值过滤；未配置默认 0.6
KNOWLEDGE_SCORE_THRESHOLD=0.6

# 合同正文段落 chunk 检索上限：0 = 不限；超过部分不再生成子 query，控制长合同的检索成本
CONTRACT_CHUNK_MAX=0

# 企业主体核验数据源(P0 阶段)
# provider 选项:tiyanji | tianyancha | qichacha | gsxt_mock | web_search(默认)
# - gsxt_mock:开发调试用固定绿色画像
# - web_search:无 token 时默认走网页搜索,从摘要提取风险关键词(真实数据)
# - tiyanji/tianyancha:Bearer 鉴权,仅需 COMPANY_API_TOKEN
# - qichacha:AppKey+SecretKey 签名,需 COMPANY_API_TOKEN + COMPANY_API_SECRET
COMPANY_API_PROVIDER=web_search
COMPANY_API_TOKEN=
COMPANY_API_SECRET=
COMPANY_API_BASE_URL=https://api.tiyanji.com/v2

# You.com 搜索集成
# API Key: https://ydc-index.io
YOUCOM_API_KEY=
# 设为 false 可禁用 You.com，强制回退到 Bing/Baidu/360 HTML 抓取
YOUCOM_SEARCH_ENABLED=true
