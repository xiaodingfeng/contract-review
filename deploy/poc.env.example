# Copy to deploy/poc.env on the target server and replace all placeholder values.
POSTGRES_USER=contract_review
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=contract_review
DB_POOL_MAX=20

# OpenAI-compatible chat model. Required for real contract analysis.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=90000
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_MS=800

# Embedding/rerank services are optional for the POC. Without them, retrieval
# uses the built-in development embedding fallback and skips reranking.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
VECTOR_SEARCH_CONCURRENCY=10

REVIEW_KB_ONLY_MODE=true
VECTOR_STORE=postgres
KNOWLEDGE_SEED_TYPES=law,case
FORCE_RESEED_LAWS=false
FORCE_RESEED_CASES=false
COMPANY_API_PROVIDER=gsxt_mock
YOUCOM_SEARCH_ENABLED=false

APP_HOST=http://your-server-ip:8080
ONLYOFFICE_URL=http://onlyoffice
# Browser-facing address. Keep OnlyOffice behind the authenticated app proxy.
ONLYOFFICE_PUBLIC_URL=/onlyoffice/
ONLYOFFICE_PORT=8081
ONLYOFFICE_JWT_SECRET=replace-with-a-separate-long-random-secret
BACKEND_URL_FOR_DOCKER=http://backend:3000
